{
  "name": "express-mcp-server",
  "version": "1.0.1",
  "description": "A tool that creates an mcp server for your current express routes.",
  "keywords": [
    "mcp",
    "server",
    "express",
    "model-context-protocol",
    "code-generation"
  ],
  "homepage": "https://github.com/mr-anvesh/express-mcp#readme",
  "bugs": {
    "url": "https://github.com/mr-anvesh/express-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mr-anvesh/express-mcp.git"
  },
  "license": "ISC",
  "author": "d0minator",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test",
    "prepublishOnly": "npm run build",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "express": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.5",
    "express": "^4.18.2",
    "typescript": "^5.3.3"
  }
}
