{
  "name": "express-mcp-server",
  "version": "1.0.3",
  "description": "Generate standalone MCP servers from selected Express routes.",
  "keywords": [
    "mcp",
    "server",
    "express",
    "model-context-protocol",
    "code-generation"
  ],
  "homepage": "https://github.com/mr-anvesh/express-mcp#readme",
  "bugs": {
    "url": "https://github.com/mr-anvesh/express-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mr-anvesh/express-mcp.git"
  },
  "license": "ISC",
  "author": "d0minator",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "check": "npm run format:check && npm run lint && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src test",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "express": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.5",
    "eslint": "^9.39.5",
    "express": "^4.18.2",
    "express5": "npm:express@^5.3.0",
    "prettier": "^3.9.10",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.72.1"
  }
}
